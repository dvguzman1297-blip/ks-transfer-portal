NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- Public transfer requests (server-side only, never expose with NEXT_PUBLIC_) ---
# Required for /request to save requests (Supabase > Settings > API > service_role key)
SUPABASE_SERVICE_ROLE_KEY=
# Optional extra notifications when a request arrives
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=leader1@example.com,leader2@example.com
NOTIFY_EMAIL_FROM=
